{
  "name": "sekiban-dcb-meeting-room",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-18",
  "vars": {
    "AUTO_DRAIN_OUTBOX": "true",
    "DIRECT_DOORBELL_DEGRADATION": "queued-degraded"
  },
  "assets": { "directory": "public" },
  "triggers": { "crons": ["* * * * *"] },
  "services": [
    { "binding": "RUNTIME", "service": "sekiban-dcb-meeting-room", "entrypoint": "runtime" }
  ],
  "hyperdrive": [
    { "binding": "HYPERDRIVE", "id": "c236b7b51ed24bf4b312bc370c61a231" }
  ],
  "queues": {
    "producers": [{ "binding": "DOWNSTREAM_QUEUE", "queue": "serialized-dcb-v1-downstream" }],
    "consumers": [{ "queue": "serialized-dcb-v1-downstream" }]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ALLOCATOR", "class_name": "AllocatorDurableObject" },
      { "name": "JOURNAL", "class_name": "JournalDurableObject" },
      { "name": "TAG", "class_name": "TagDurableObject" },
      { "name": "TAG_STATE", "class_name": "TagStateDurableObject" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AllocatorDurableObject", "JournalDurableObject", "TagDurableObject"] },
    { "tag": "v2", "new_sqlite_classes": ["TagStateDurableObject"] }
  ]
}
