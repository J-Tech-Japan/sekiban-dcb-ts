{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "sekiban-dcb-meeting-room-cloudflare-only",
  "main": "src/worker.g32-bridge.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "G32_BRIDGE_COMPONENT": "primary",
    "G32_BRIDGE_SOURCE_COMMIT": "unsealed",
    "G32_BRIDGE_CONFIG_DIGEST": "unsealed",
    "G32_FREEZE_TOKEN_FINGERPRINT": "unsealed"
  },
  "d1_databases": [
    { "binding": "D1", "database_name": "sekiban-dcb-meeting-room-cloudflare-pipeline", "database_id": "3c3b1641-7969-4d72-97a9-2ea65085c9bb", "migrations_dir": "../../migrations/d1" },
    { "binding": "D1_MV", "database_name": "sekiban-dcb-meeting-room-cloudflare-mv", "database_id": "5db45136-f1dd-4f4d-bfe3-b6328193a1ac", "migrations_dir": "../../migrations/mv" }
  ],
  "queues": {
    "producers": [{ "binding": "DOWNSTREAM_QUEUE", "queue": "sekiban-dcb-meeting-room-cloudflare-outbox" }],
    "consumers": [{ "queue": "sekiban-dcb-meeting-room-cloudflare-outbox", "max_batch_timeout": 1, "max_retries": 3, "dead_letter_queue": "sekiban-dcb-meeting-room-cloudflare-outbox-dlq" }]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ALLOCATOR", "class_name": "AllocatorDurableObject" },
      { "name": "JOURNAL", "class_name": "JournalDurableObject" },
      { "name": "TAG", "class_name": "TagDurableObject" },
      { "name": "BOOTSTRAP", "class_name": "BootstrapCoordinatorDurableObject" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AllocatorDurableObject", "JournalDurableObject", "TagDurableObject"] }, { "tag": "v2", "new_sqlite_classes": ["BootstrapCoordinatorDurableObject"] }]
}
