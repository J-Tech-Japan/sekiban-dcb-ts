{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "sekiban-dcb-g26-doorbell",
  "main": "src/worker.cloudflare-only.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "DOMAIN_DELIVERY_CLASS": "immediate-preferred",
    "DIRECT_DOORBELL": "true",
    "DIRECT_DOORBELL_ALLOWED_VIEWS": "RoomProjector,ReservationProjector",
    "DIRECT_DOORBELL_MAX_INVOCATIONS": "32",
    "DIRECT_DOORBELL_DEGRADATION": "fail-fast",
    "DIRECT_DOORBELL_RECEIVER_MODE": "separate",
    "G26_VIEW_COUNT": "2"
  },
  "d1_databases": [
    {
      "binding": "D1",
      "database_name": "sekiban-dcb-meeting-room-cloudflare-pipeline",
      "database_id": "REPLACE_WITH_SAMPLE_DOORBELL_PIPELINE_D1_ID",
      "migrations_dir": "../../migrations/d1"
    },
    {
      "binding": "D1_MV",
      "database_name": "sekiban-dcb-meeting-room-cloudflare-mv",
      "database_id": "REPLACE_WITH_SAMPLE_DOORBELL_MV_D1_ID",
      "migrations_dir": "../../migrations/mv"
    }
  ],
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
