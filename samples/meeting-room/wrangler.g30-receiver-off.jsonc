{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "sekiban-dcb-meeting-room-doorbell",
  "main": "src/worker.cloudflare-only.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "DOMAIN_DELIVERY_CLASS": "immediate-preferred",
    "DIRECT_DOORBELL": "true",
    "DIRECT_DOORBELL_ALLOWED_VIEWS": "RoomProjector,ReservationProjector",
    "DIRECT_DOORBELL_MAX_INVOCATIONS": "32",
    "DIRECT_DOORBELL_DEGRADATION": "fail-fast",
    "DIRECT_DOORBELL_RECEIVER_MODE": "separate",
    "G26_VIEW_COUNT": "2",
    "G32_CUTOVER_PHASE": "final-g32",
    "G32_FREEZE_RELEASE": "after-new-bindings",
    "G32_COMPONENT": "receiver",
    "G32_PIPELINE_DATABASE_ID": "REPLACE_WITH_G32_FINAL_PIPELINE_D1_ID",
    "G32_MATERIALIZED_VIEW_DATABASE_ID": "REPLACE_WITH_G32_FINAL_MV_D1_ID",
    "G32_QUEUE_NAME": "sekiban-dcb-meeting-room-g32-9043d626fe1149cb-outbox"
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "persist": true, "invocation_logs": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0, "persist": true }
  },
  "version_metadata": { "binding": "WORKER_VERSION" },
  "d1_databases": [
    {
      "binding": "D1",
      "database_name": "sekiban-dcb-meeting-room-g32-9043d626fe1149cb-pipeline",
      "database_id": "REPLACE_WITH_G32_FINAL_PIPELINE_D1_ID",
      "migrations_dir": "../../migrations/d1/g32"
    },
    {
      "binding": "D1_MV",
      "database_name": "sekiban-dcb-meeting-room-g32-9043d626fe1149cb-mv",
      "database_id": "REPLACE_WITH_G32_FINAL_MV_D1_ID",
      "migrations_dir": "../../migrations/mv"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ALLOCATOR", "class_name": "AllocatorDurableObject" },
      { "name": "JOURNAL", "class_name": "JournalDurableObject" },
      { "name": "TAG", "class_name": "TagDurableObject" },
      { "name": "BOOTSTRAP", "class_name": "BootstrapCoordinatorDurableObject" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AllocatorDurableObject", "JournalDurableObject", "TagDurableObject"] },
    { "tag": "v2", "new_sqlite_classes": ["BootstrapCoordinatorDurableObject"] }
  ],
  "workers_dev": false,
  "preview_urls": false
}
