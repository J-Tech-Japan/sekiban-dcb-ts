{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "sekiban-dcb-meeting-room-cloudflare-only",
  "main": "src/worker.cloudflare-only.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "AUTO_DRAIN_OUTBOX": "true",
    "DOMAIN_DELIVERY_CLASS": "immediate-preferred",
    "DIRECT_DOORBELL": "false",
    "DIRECT_DOORBELL_ALLOWED_VIEWS": "RoomProjector,ReservationProjector",
    "DIRECT_DOORBELL_MAX_INVOCATIONS": "32",
    "DIRECT_DOORBELL_DEGRADATION": "queued-degraded",
    "DIRECT_DOORBELL_RECEIVER_MODE": "separate",
    "G26_VIEW_COUNT": "2",
    "SDT_SERVICE_ID": "sekiban-dcb-meeting-room-cloudflare-only"
  },
  "assets": { "directory": "public" },
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    {
      "binding": "D1",
      "database_name": "sekiban-dcb-meeting-room-cloudflare-pipeline",
      "database_id": "23d8696c-92ae-4753-bb37-86583b1f2923",
      "migrations_dir": "../../migrations/d1"
    },
    {
      "binding": "D1_MV",
      "database_name": "sekiban-dcb-meeting-room-cloudflare-mv",
      "database_id": "b416b212-4d09-413c-9b8d-7660e475772f",
      "migrations_dir": "../../migrations/mv"
    }
  ],
  "queues": {
    "producers": [{ "binding": "DOWNSTREAM_QUEUE", "queue": "sekiban-dcb-meeting-room-cloudflare-outbox" }],
    "consumers": [{
      "queue": "sekiban-dcb-meeting-room-cloudflare-outbox",
      "max_batch_timeout": 1,
      "max_retries": 3,
      "dead_letter_queue": "sekiban-dcb-meeting-room-cloudflare-outbox-dlq"
    }]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ALLOCATOR", "class_name": "AllocatorDurableObject" },
      { "name": "JOURNAL", "class_name": "JournalDurableObject" },
      { "name": "TAG", "class_name": "TagDurableObject" },
      { "name": "TAG_STATE", "class_name": "TagStateDurableObject" },
      { "name": "BOOTSTRAP", "class_name": "BootstrapCoordinatorDurableObject" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AllocatorDurableObject", "JournalDurableObject", "TagDurableObject"] }, { "tag": "v2", "new_sqlite_classes": ["BootstrapCoordinatorDurableObject"] }, { "tag": "v3", "new_sqlite_classes": ["TagStateDurableObject"] }]
}
