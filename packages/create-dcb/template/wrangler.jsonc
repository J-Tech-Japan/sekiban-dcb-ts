{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "{{WORKER_NAME}}",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "DOMAIN_DELIVERY_CLASS": "immediate-preferred",
    "SDT_SERVICE_ID": "{{SERVICE_ID}}"
  },
  "assets": { "directory": "public" },
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    {
      "binding": "D1",
      "database_name": "{{PIPELINE_DB}}",
      "database_id": "REPLACE_WITH_PIPELINE_D1_ID",
      "migrations_dir": "migrations/d1/g32"
    },
    {
      "binding": "D1_MV",
      "database_name": "{{MV_DB}}",
      "database_id": "REPLACE_WITH_MV_D1_ID",
      "migrations_dir": "migrations/mv"
    }
  ],
  "queues": {
    "producers": [{ "binding": "DOWNSTREAM_QUEUE", "queue": "{{QUEUE_NAME}}" }],
    "consumers": [{
      "queue": "{{QUEUE_NAME}}",
      "max_batch_timeout": 1,
      "max_retries": 3,
      "dead_letter_queue": "{{DLQ_NAME}}"
    }]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ALLOCATOR", "class_name": "AllocatorDurableObject" },
      { "name": "BOOTSTRAP", "class_name": "BootstrapCoordinatorDurableObject" },
      { "name": "JOURNAL", "class_name": "JournalDurableObject" },
      { "name": "TAG", "class_name": "TagDurableObject" },
      { "name": "TAG_STATE", "class_name": "TagStateDurableObject" }
    ]
  },
  "migrations": [{
    "tag": "v1",
    "new_sqlite_classes": ["AllocatorDurableObject", "JournalDurableObject", "TagDurableObject"]
  }, {
    "tag": "v2",
    "new_sqlite_classes": ["BootstrapCoordinatorDurableObject"]
  }, {
    "tag": "v3",
    "new_sqlite_classes": ["TagStateDurableObject"]
  }]
}
