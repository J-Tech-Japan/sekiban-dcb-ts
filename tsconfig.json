{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "@cloudflare/workers-types",
      "@cloudflare/vitest-pool-workers/types",
      "vitest/globals"
    ]
  },
  "include": [
    "packages/dcb-core/src/**/*.ts",
    "packages/dcb-domain/src/**/*.ts",
    "packages/dcb-runtime/src/**/*.ts",
    "packages/dcb-client/src/**/*.ts",
    "packages/dcb-cloudflare/src/index.ts",
    "packages/dcb-cloudflare/src/compose.ts",
    "samples/meeting-room/src/**/*.ts",
    "test/**/*.ts",
    "scripts/g29-mapping-contract.d.mts",
    "scripts/g29-delivery-matrix.d.mts",
    "scripts/g30-b0-contract.d.mts",
    "scripts/g30-config-check.d.mts",
    "scripts/deploy/g29-witness.d.mts",
    "scripts/deploy/g29-measure.d.mts",
    "scripts/deploy/g30-b0-measure.d.mts",
    "scripts/deploy/g30-deployment-witness.d.mts",
    "scripts/deploy/g30-trace-export.d.mts",
    "scripts/deploy/g50-commit-latency.d.mts",
    "scripts/deploy/g52-commit-breakdown.d.mts",
    "scripts/deploy/g52-commit-breakdown-check.d.mts",
    "vitest.config.ts",
    "worker.ts"
  ]
}
