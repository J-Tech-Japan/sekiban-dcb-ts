{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "sekiban-dcb-g60-w131-c",
  "main": "../samples/meeting-room/src/worker.cloudflare-only.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "AUTO_DRAIN_OUTBOX": "true",
    "DOMAIN_DELIVERY_CLASS": "immediate-preferred",
    "DIRECT_DOORBELL": "true",
    "DIRECT_DOORBELL_ALLOWED_VIEWS": "RoomProjector,ReservationProjector",
    "DIRECT_DOORBELL_MAX_INVOCATIONS": "32",
    "DIRECT_DOORBELL_DEGRADATION": "queued-degraded",
    "DIRECT_DOORBELL_RECEIVER_MODE": "self",
    "DIRECT_DOORBELL_SELF_BINDING_PROOF": "true",
    "G26_VIEW_COUNT": "2",
    "G32_COMPONENT": "primary",
    "G32_CUTOVER_PHASE": "final-g32",
    "G32_FREEZE_RELEASE": "after-new-bindings",
    "G32_CUTOVER_FENCE_FINGERPRINT": "ce80a2a5d31fe0e74c8d488ee0d95af3e537bf0981252020ce6b22fcf62ec857",
    "G32_PIPELINE_DATABASE_ID": "b03270df-9698-4a9e-94c6-c2c5726f106d",
    "G32_MATERIALIZED_VIEW_DATABASE_ID": "616dd377-42f3-49f7-b373-a1a07cedf2b3",
    "G32_QUEUE_NAME": "sekiban-dcb-g60-w131-c-outbox",
    "SDT_SERVICE_ID": "sekiban-dcb-g60-w131-c"
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "persist": true, "invocation_logs": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 1, "persist": true }
  },
  "assets": { "directory": "../samples/meeting-room/public" },
  "triggers": { "crons": ["* * * * *"] },
  "services": [
    {
      "binding": "DOWNSTREAM_DOORBELL",
      "service": "sekiban-dcb-g60-w131-c",
      "entrypoint": "MeetingRoomDownstreamDoorbell"
    }
  ],
  "d1_databases": [
    {
      "binding": "D1",
      "database_name": "sekiban-dcb-g60-w131-c-pipeline",
      "database_id": "b03270df-9698-4a9e-94c6-c2c5726f106d",
      "migrations_dir": "../migrations/d1/g32"
    },
    {
      "binding": "D1_MV",
      "database_name": "sekiban-dcb-g60-w131-c-mv",
      "database_id": "616dd377-42f3-49f7-b373-a1a07cedf2b3",
      "migrations_dir": "../migrations/mv"
    }
  ],
  "queues": {
    "producers": [{ "binding": "DOWNSTREAM_QUEUE", "queue": "sekiban-dcb-g60-w131-c-outbox" }],
    "consumers": [{
      "queue": "sekiban-dcb-g60-w131-c-outbox",
      "max_batch_timeout": 1,
      "max_retries": 3,
      "dead_letter_queue": "sekiban-dcb-g60-w131-c-outbox-dlq"
    }]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ALLOCATOR", "class_name": "AllocatorDurableObject" },
      { "name": "JOURNAL", "class_name": "JournalDurableObject" },
      { "name": "TAG", "class_name": "TagDurableObject" },
      { "name": "TAG_STATE", "class_name": "TagStateDurableObject" },
      { "name": "BOOTSTRAP", "class_name": "BootstrapCoordinatorDurableObject" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AllocatorDurableObject", "JournalDurableObject", "TagDurableObject"] },
    { "tag": "v2", "new_sqlite_classes": ["BootstrapCoordinatorDurableObject"] },
    { "tag": "v3", "new_sqlite_classes": ["TagStateDurableObject"] }
  ]
}
