{
  "name": "serialized-dcb-v1-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "Serialized DCB V1 5-endpoint runtime Journal Durable Object bootstrap.",
  "type": "module",
  "workspaces": [
    "packages/dcb-core",
    "packages/dcb-runtime",
    "packages/dcb-client"
  ],
  "scripts": {
    "build:packages": "npm run build --workspaces --if-present",
    "build": "npm run build:packages && wrangler deploy --dry-run",
    "deploy:g11": "bash scripts/deploy/g11-deploy.sh",
    "conformance:g11": "bash scripts/deploy/g11-conformance.sh",
    "measure:g11": "python3 scripts/deploy/g11-measure.py",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "npm run build:packages && tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:local-pg": "docker compose up --wait postgres && npm test",
    "test:watch": "vitest --config vitest.config.ts",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.21.3",
    "@cloudflare/workers-types": "5.20260817.1",
    "@eslint/js": "9.39.2",
    "eslint": "9.39.2",
    "globals": "16.5.0",
    "miniflare": "5.20260811.1-alpha",
    "typescript": "5.9.3",
    "typescript-eslint": "8.50.1",
    "vitest": "4.1.10",
    "wrangler": "4.123.0"
  },
  "dependencies": {
    "postgres": "^3.4.9"
  }
}
