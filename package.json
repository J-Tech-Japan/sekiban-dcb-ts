    "eslint": "9.39.2",
    "globals": "16.5.0",
    "miniflare": "5.20260811.1-alpha",
    "typescript": "5.9.3",
    "typescript-eslint": "8.50.1",
    "vitest": "4.1.10",
    "wrangler": "4.123.0"
  }
}
