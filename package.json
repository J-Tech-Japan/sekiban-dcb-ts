{
  "name": "serialized-dcb-v1-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "Serialized DCB V1 5-endpoint runtime Journal Durable Object bootstrap.",
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run",
