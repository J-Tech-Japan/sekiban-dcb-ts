{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "serialized-dcb-v1-runtime",
  "main": "worker.ts",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "AUTO_DRAIN_OUTBOX": "true"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "c236b7b51ed24bf4b312bc370c61a231"
    }
  ],
  "d1_databases": [
    {
      "binding": "D1",
      "database_name": "serialized-dcb-v1-local",
      "database_id": "00000000-0000-0000-0000-000000000018",
      "migrations_dir": "migrations/d1"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "queues": {
    "producers": [
      {
        "binding": "DOWNSTREAM_QUEUE",
        "queue": "serialized-dcb-v1-outbox"
      }
    ],
    "consumers": [
      {
        "queue": "serialized-dcb-v1-outbox"
      }
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "JOURNAL",
        "class_name": "JournalDurableObject"
      },
      {
        "name": "ALLOCATOR",
        "class_name": "AllocatorDurableObject"
      },
      {
        "name": "TAG",
        "class_name": "TagDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["JournalDurableObject"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["AllocatorDurableObject"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["TagDurableObject"]
    }
  ]
}
